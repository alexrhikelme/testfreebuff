rules_version = '2';

/**
 * Regras do Firestore — Lab Notes Dashboards (projeto combogo-unicap).
 *
 * Modelo de acesso (projetos privados por dono/convite):
 *
 * 1. Toda conta autenticada com e-mail verificado tem um documento
 *    `users/{uid}` com papel de SITE:
 *      - "user"        → usuário padrão (criado automaticamente no cadastro);
 *      - "server_admin" → conta escolhida pelos desenvolvedores.
 *    O papel de site NÃO dá acesso a projetos de terceiros.
 *
 * 2. Projetos vivem em `dashboards/{projectId}` e carregam:
 *      - `owner_uid`    → quem criou o projeto (admin do projeto);
 *      - `member_uids`  → lista de uids com acesso (dono + convidados).
 *    O papel de cada pessoa DENTRO do projeto fica em
 *    `members/{projectId}_{uid}` com `role` em ["admin","editor","viewer"].
 *    `member_uids` existe para que as consultas de coleção sejam prováveis
 *    (`array-contains`), já que as regras não filtram resultados.
 *
 * 3. Leitura de notas/atividade exige pertencer ao projeto (`member_uids`).
 *    Escrita de conteúdo exige ser "admin" ou "editor" do projeto.
 *    Nota sem projeto é pessoal: só o dono (`owner_uid`) lê e escreve.
 *    Excluir projeto: apenas admin do projeto ou ServerADM.
 *
 * 4. ServerADM lê, escreve, altera e atribui papéis em TODOS os projetos,
 *    e ainda pode banir (`banned: true`) ou apagar perfis de terceiros.
 *    Apagar a conta de autenticação em si exige o Admin SDK / console.
 *
 * 5. `users` é o diretório do site (nome/e-mail) usado para convidar por
 *    e-mail; qualquer conta registrada pode listá-lo. O papel de site só
 *    muda por um ServerADM (nunca por conta própria).
 *
 * Bootstrap (uma única vez, no console do Firebase):
 *   Firestore → coleção `users` → documento com ID = UID do desenvolvedor
 *   → campo `role` (string) = "server_admin".
 *
 * Campos usados pelo app:
 *   users:      role, name, email, banned, created_at
 *   dashboards: name, description, owner_uid, member_uids, created_at, updated_at
 *   members:    uid, name, email, role, dashboard_id, invited_at
 *   notes:      id, title, content, status, tags, assignee, start_date,
 *               due_date, dashboard_id, sprint_id, owner_uid, member_uids,
 *               created_at, updated_at, updated_by, order
 *   sprints:    id, title, created_at
 *   activity:   note_id, note_title, action, actor, actor_uid, dashboard_id,
 *               member_uids, at
 *   admin_requests: uid, name, email, requested_at
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- base
    function signedIn() {
      return request.auth != null;
    }

    function emailVerified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    /** Documento de perfil do solicitante (as regras o leem mesmo sem regra). */
    function profile() {
      return get(profilePath(request.auth.uid));
    }

    function hasProfile() {
      return signedIn() && exists(profilePath(request.auth.uid));
    }

    /** Papel de SITE do solicitante. */
    function siteRole() {
      return hasProfile() ? profile().data.role : 'none';
    }

    /**
     * Cadastro válido: e-mail verificado, perfil existente, papel de site
     * reconhecido e conta não banida. "admin"/"editor"/"viewer" são papéis
     * legados (modelo anterior) e continuam valendo como usuário comum.
     */
    function isRegistered() {
      return emailVerified()
        && hasProfile()
        && siteRole() in ['user', 'server_admin', 'admin', 'editor', 'viewer']
        && profile().data.banned != true;
    }

    function isServerAdmin() {
      return isRegistered() && siteRole() == 'server_admin';
    }

    // ------------------------------------------------------------- projetos
    function projectPath(projectId) {
      return /databases/$(database)/documents/dashboards/$(projectId);
    }

    function memberPath(projectId) {
      return /databases/$(database)/documents/members/$(projectId + '_' + request.auth.uid);
    }

    /** Papel do solicitante no projeto: admin | editor | viewer | none. */
    function projectRole(projectId) {
      return exists(memberPath(projectId)) ? get(memberPath(projectId)).data.role : 'none';
    }

    function isProjectOwner(projectId) {
      return exists(projectPath(projectId))
        && get(projectPath(projectId)).data.owner_uid == request.auth.uid;
    }

    function isProjectAdmin(projectId) {
      return isRegistered() && (
        isServerAdmin()
        || isProjectOwner(projectId)
        || projectRole(projectId) == 'admin'
      );
    }

    function isProjectEditor(projectId) {
      return isRegistered() && (
        isProjectAdmin(projectId) || projectRole(projectId) == 'editor'
      );
    }

    function noteStatus() {
      return ['not_started', 'in_progress', 'completed', 'blocked'];
    }

    function memberRoles() {
      return ['admin', 'editor', 'viewer'];
    }

    function activityActions() {
      return ['created', 'updated', 'status_changed', 'moved', 'deleted'];
    }

    function canWriteNote() {
      return isServerAdmin()
        || ('dashboard_id' in resource.data
            && resource.data.dashboard_id != null
            && isProjectEditor(resource.data.dashboard_id))
        || (('dashboard_id' in resource.data
            && resource.data.dashboard_id == null)
            && resource.data.owner_uid == request.auth.uid);
    }

    // ------------------------------------------------------------ projetos
    match /dashboards/{projectId} {
      allow get, list: if isRegistered()
        && (isServerAdmin() || request.auth.uid in resource.data.member_uids);

      allow create: if isRegistered()
        && request.resource.data.owner_uid == request.auth.uid
        && request.resource.data.member_uids == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;

      allow update: if isProjectAdmin(projectId)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.owner_uid == resource.data.owner_uid;

      allow delete: if isProjectAdmin(projectId);
    }

    // ------------------------------------------------------------- membros
    // Diretório de membros: qualquer conta registrada lê (é assim que o app
    // descobre nomes/e-mails para convidar). Papéis só o admin do projeto.
    match /members/{memberId} {
      allow read: if isRegistered();

      allow create, update: if isRegistered() && (
        isProjectAdmin(request.resource.data.dashboard_id)
        || (
          // O criador registra a si mesmo como admin do projeto novo.
          request.resource.data.uid == request.auth.uid
          && request.resource.data.role == 'admin'
          && isProjectOwner(request.resource.data.dashboard_id)
        )
      )
      && request.resource.data.uid is string
      && request.resource.data.role in memberRoles();

      allow delete: if isRegistered()
        && isProjectAdmin(resource.data.dashboard_id);
    }

    // --------------------------------------------------------------- notas
    match /notes/{noteId} {
      allow get, list: if isRegistered()
        && (isServerAdmin()
            || (request.auth.uid in resource.data.member_uids));

      allow create: if isRegistered()
        && request.resource.data.owner_uid == request.auth.uid
        && request.resource.data.member_uids.hasAll([request.auth.uid])
        && (
          !('dashboard_id' in request.resource.data)
          || request.resource.data.dashboard_id == null
          || isProjectEditor(request.resource.data.dashboard_id)
        )
        && request.resource.data.keys().hasAll(['title', 'status', 'tags', 'created_at'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.status in noteStatus()
        && request.resource.data.tags is list;

      allow update: if canWriteNote()
        && request.resource.data.title is string
        && request.resource.data.status in noteStatus()
        && request.resource.data.tags is list;

      allow delete: if canWriteNote();
    }

    // -------------------------------------------------------------- sprints
    // Colunas do quadro são estrutura compartilhada (sem conteúdo sensível);
    // continuam abertas a qualquer conta registrada.
    match /sprints/{sprintId} {
      allow read: if isRegistered();

      allow create, update: if isRegistered()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0;

      allow delete: if isRegistered();
    }

    // ------------------------------------------------------------ atividade
    match /activity/{activityId} {
      allow get, list: if isRegistered()
        && (isServerAdmin()
            || (request.auth.uid in resource.data.member_uids));

      allow create: if isRegistered()
        && request.resource.data.actor_uid == request.auth.uid
        && request.resource.data.note_id is string
        && request.resource.data.action in activityActions();

      // Histórico é imutável, exceto a lista de membros (sincronizada pelo
      // admin do projeto quando alguém é removido).
      allow update: if isRegistered()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['member_uids'])
        && (
          isServerAdmin()
          || ('dashboard_id' in resource.data
              && resource.data.dashboard_id != null
              && isProjectAdmin(resource.data.dashboard_id))
        );

      allow delete: if false;
    }

    // -------------------------------------------------------------- perfis
    match /users/{uid} {
      // O próprio usuário lê o perfil (para saber se já é ServerADM);
      // listar o diretório exige conta registrada.
      allow get: if signedIn() && (request.auth.uid == uid || isServerAdmin());
      allow list: if isRegistered();

      // Cadastro se autoprovisiona como "user" — nunca como admin.
      allow create: if emailVerified()
        && request.auth.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.banned == false
        && request.resource.data.email == request.auth.token.email;

      // Papel de site e banimento: só ServerADM (e nunca a si mesmo, para
      // não se trancar fora).
      allow update: if isServerAdmin()
        && request.auth.uid != uid
        && request.resource.data.role in ['user', 'server_admin'];

      // Remoção do perfil: só ServerADM, nunca o próprio.
      allow delete: if isServerAdmin() && request.auth.uid != uid;
    }

    // -------------------------------------------- pedidos de ServerADM
    match /admin_requests/{uid} {
      allow get, list: if signedIn() && (request.auth.uid == uid || isServerAdmin());

      allow create: if isRegistered()
        && request.auth.uid == uid
        && request.resource.data.uid == uid;

      allow update: if isServerAdmin();
      allow delete: if isServerAdmin() || request.auth.uid == uid;
    }

    // Qualquer outra coleção é negada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
